type Product {
    id: ID!
    name: String!
    price: Float!
    category: String!
}

input InputProduct {
    name: String!
    price: Float!
    category: String!
}
type Query {
    getAllProducts(page: Int, size: Int, sortBy: String, order: String, search: String, minPrice: Float, maxPrice: Float, category: String): [Product!]!
    exportProducts: String!
}

type Mutation {
    importProducts(products: [InputProduct!]!): Boolean!
}
